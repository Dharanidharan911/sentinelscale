# SentinelScale Environment Configuration Template
# Copy to .env for local runtime execution

# Environment Mode: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service Port Configuration
DEMO_API_PORT=8000
TRAFFIC_INTELLIGENCE_PORT=8001
DEMAND_INTELLIGENCE_PORT=8002
PLATFORM_PORT=8003
PROMETHEUS_PORT=9090

# Internal Service URLs (for Docker / Kubernetes)
TRAFFIC_INTELLIGENCE_URL=http://traffic-intelligence:8001
DEMAND_INTELLIGENCE_URL=http://demand-intelligence:8002
PLATFORM_URL=http://platform:8003
DEMO_API_URL=http://demo-api:8000
PROMETHEUS_URL=http://prometheus:9090
# Demand Intelligence uses Prometheus only when this separate opt-in URL is set.
DEMAND_PROMETHEUS_URL=
# Query must return RPS samples and may contain {target_service}.
DEMAND_PROMETHEUS_QUERY=sum(rate(http_requests_total{service="{target_service}"}[1m]))

# Safety Guardrail & Decision Engine Modes
SENTINEL_DRY_RUN=true
SENTINEL_SHADOW_MODE=true
SENTINEL_AUTONOMOUS_ACTIONS_ENABLED=false

# Baseline HPA Configuration
BASELINE_TARGET_CPU_UTILIZATION=0.70
BASELINE_MIN_PODS=2
BASELINE_MAX_PODS=20
BASELINE_POD_RPS_CAPACITY=350.0
